generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  name               String?
  password           String?
  image              String?
  role               Role           @default(USER)
  referralCode       String?        @unique
  referredBy         String?
  referralCount      Int            @default(0)
  paidReferralCount  Int            @default(0)
  commission         Float          @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  emailVerified      DateTime?
  accountName        String?
  accountNumber      String?
  apartment          String?
  bankName           String?
  city               String?
  country            String?
  phone              String?
  whatsapp           String?
  state              String?
  streetAddress      String?
  zipCode            String?
  emailNotifications Boolean        @default(true)
  marketingEmails    Boolean        @default(true)
  hideFromDirectory  Boolean        @default(false)
  themePreference    String?        @default("system")
  nin                String?        @unique
  isSuperAdmin       Boolean        @default(false)
  ninVerified        Boolean        @default(false)
  lastLoginAt        DateTime?
  unverifiedCleanupWarningSentAt DateTime?
  accounts           Account[]
  sessions           Session[]
  notifications      Notification[]
  auditLogs          AuditLog[] // ✅ added
  referrer           User?          @relation("Referrals", fields: [referredBy], references: [id])
  referrals          User[]         @relation("Referrals")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SystemSettings {
  id                      String    @id @default("singleton")
  emailLimitEnabled       Boolean   @default(true)
  emailDailyLimit         Int       @default(100)
  commissionPerVerifiedReferral Int @default(1000)
  unverifiedCleanupPolicyStartedAt DateTime?
  updatedAt               DateTime  @updatedAt
  ninVerificationRequired Boolean   @default(true)
  registrationPaused      Boolean   @default(false)
  registrationPauseReason String?   @db.Text
  registrationPauseUntil  DateTime?
  registrationPausedBy    String?
  registrationPausedAt    DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "referral", "realtor", "milestone", "commission"
  message   String
  link      String? // URL to navigate to
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // who performed the action; null for automated/system jobs
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. "ROLE_CHANGE", "DELETE_USER", "BULK_DELETE", "SETTINGS_UPDATE"
  details   Json // additional context (e.g., { oldRole: "USER", newRole: "REALTOR" })
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model EmailTemplate {
  id              String           @id @default(cuid())
  name            String           @unique // "welcome", "milestone", "referral", "custom"
  subject         String
  body            String           @db.Text // HTML content
  variables       String[] // list of required variables
  scheduledEmails ScheduledEmail[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ScheduledEmail {
  id          String         @id @default(cuid())
  templateId  String?
  template    EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subject     String
  body        String         @db.Text
  recipients  String[] // array of user IDs
  scheduledAt DateTime
  sentAt      DateTime?
  status      String         @default("pending") // pending, sent, failed
  createdAt   DateTime       @default(now())

  @@index([scheduledAt, status])
}

model EmailLog {
  id     String   @id @default(cuid())
  sentAt DateTime @default(now())

  @@index([sentAt])
}

enum Role {
  USER
  REALTOR
  ADMIN
}
